#!/bin/sh
# Harbor Settings › Keyboard Manager: save the rules read from stdin to
# /etc/harbor/keymap.conf and start, restart or stop the remapping service.
# Only rule lines are accepted, so nothing else can reach the root service.
set -eu
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
head -c 65536 > "$tmp"
if grep -qvE '^(enabled (true|false)|(key|shortcut) [A-Z0-9_+]+ [A-Z0-9_+]+)$' "$tmp"; then
    echo "These are not Keyboard Manager rules" >&2
    exit 2
fi
mkdir -p /etc/harbor
install -m 0644 "$tmp" /etc/harbor/keymap.conf
if grep -qx 'enabled true' "$tmp" && grep -qE '^(key|shortcut) ' "$tmp"; then
    systemctl enable harbor-keymapd.service >/dev/null 2>&1 || true
    systemctl restart harbor-keymapd.service
else
    systemctl disable --now harbor-keymapd.service >/dev/null 2>&1 || true
fi
