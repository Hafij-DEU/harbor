<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Harbor</vendor>
  <action id="io.github.hafij_deu.Harbor.Keyboard.apply">
    <description>Change Keyboard Manager settings</description>
    <message>Changing keyboard settings needs permission</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/win11-settings/harbor-keyboard-apply</annotate>
  </action>
</policyconfig>
