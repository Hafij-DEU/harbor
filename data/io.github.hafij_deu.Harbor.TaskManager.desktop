[Desktop Entry]
Type=Application
Name=Harbor Task Manager
GenericName=Task Manager
Comment=See running apps and processes, performance, startup apps and services
Exec=harbor-taskmgr
Icon=io.github.hafij_deu.Harbor.TaskManager
Terminal=false
Categories=GTK;System;Monitor;
Keywords=task manager;process;kill;cpu;memory;performance;startup;services;end task;
StartupNotify=true
SingleMainWindow=true
Actions=performance;memory;swap;sweep;files;optimization;details;

[Desktop Action performance]
Name=Performance
Exec=harbor-taskmgr --page performance

[Desktop Action memory]
Name=Memory
Exec=harbor-taskmgr --page performance:memory

[Desktop Action swap]
Name=Swap
Exec=harbor-taskmgr --page performance:swap

[Desktop Action sweep]
Name=Memory Sweep
Exec=harbor-taskmgr --page sweep

[Desktop Action files]
Name=Files in memory
Exec=harbor-taskmgr --page sweep:files

[Desktop Action optimization]
Name=Memory optimization
Exec=harbor-taskmgr --page settings:optimization

[Desktop Action details]
Name=Details
Exec=harbor-taskmgr --page details
